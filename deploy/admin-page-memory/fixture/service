#!/usr/bin/env bash
# Fixture-only process wrapper. PID and log stay in this directory.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$ROOT/server.pid"
LOG_FILE="$ROOT/server.log"
PORT="${FIXTURE_PORT:-8766}"

running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}
case "${1:-}" in
  start)
    if running; then
      echo "fixture already running (pid $(cat "$PID_FILE"), port $PORT)"
      exit 0
    fi
    rm -f "$PID_FILE"
    nohup env FIXTURE_PORT="$PORT" node "$ROOT/server.mjs" >>"$LOG_FILE" 2>&1 &
    pid=$!
    echo "$pid" >"$PID_FILE"
    for _ in $(seq 1 30); do
      if curl -fsS --max-time 1 "http://127.0.0.1:$PORT/__fixture/health" >/dev/null; then
        echo "fixture started (pid $pid, http://0.0.0.0:$PORT)"
        exit 0
      fi
      if ! kill -0 "$pid" 2>/dev/null; then
        echo "fixture failed to start; see $LOG_FILE" >&2
        rm -f "$PID_FILE"
        exit 1
      fi
      sleep 0.1
    done
    echo "fixture process started but health check did not become ready; see $LOG_FILE" >&2
    exit 1
    ;;
  stop)
    if running; then
      kill "$(cat "$PID_FILE")"
      rm -f "$PID_FILE"
      echo "fixture stopped"
    else
      rm -f "$PID_FILE"
      echo "fixture not running"
    fi
    ;;
  status)
    if running; then
      echo "fixture running (pid $(cat "$PID_FILE"), port $PORT)"
      curl -fsS --max-time 2 "http://127.0.0.1:$PORT/__fixture/health"
      echo
    else
      echo "fixture not running"
      exit 3
    fi
    ;;
  *)
    echo "usage: $0 {start|stop|status}" >&2
    exit 2
    ;;
esac
