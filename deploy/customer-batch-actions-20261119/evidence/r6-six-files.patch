+        elif not path.startswith(b'/'):
+            need(path.startswith(b'[') and path.endswith(b']'), 'DYNAMIC_UNSUPPORTED_MAPPING')
+    return sorted(records)  # retain multiplicity and size, not absolute ASLR positions
