+def r5_map(path, address='1000-2000', perms='r-xp'):
+    s = Path(path).stat()
+    return (f'{address} {perms} 00000000 {os.major(s.st_dev):x}:{os.minor(s.st_dev):x} {s.st_ino} {path}\n').encode()
