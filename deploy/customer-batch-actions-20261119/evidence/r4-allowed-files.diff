+def r4_stat(pid, ppid, ticks, name):
+    fields = ['S', str(ppid), *(['0'] * 17), str(ticks), '0']
+    return str(pid).encode() + b' (' + name.encode() + b') ' + ' '.join(fields).encode() + b'\n'
+
