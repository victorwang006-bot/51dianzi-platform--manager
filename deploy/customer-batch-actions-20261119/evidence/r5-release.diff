+def dynamic_protection_sample(cfg, ops, cwd, script, budget):
+    roots = {str(p): describe(no_link(p)) for p in sorted({ops, cwd, *cfg.execution_roots})}
+    need(all(r['kind'] == 'directory' for r in roots.values()), 'DYNAMIC_ROOT_DIRECTORIES')
+    pidfile = dynamic_source(cfg.pm2_home / 'pm2.pid', budget)
+    pidraw = dynamic_read(cfg.pm2_home / 'pm2.pid', DYNAMIC_PROC_BYTES, budget)
+    need(re.fullmatch(rb'[1-9][0-9]*\s*', pidraw), 'DYNAMIC_MAIN_DAEMON_PID')
+    main = int(pidraw.strip()); candidates = dynamic_scan(cfg, budget)
+    need(main in candidates, 'DYNAMIC_MAIN_GOD_NOT_IN_NODE_SET')
+    full, payloads = {}, {}
+    def collect(pid):
+        if pid not in full:
+            need(len(full) < DYNAMIC_MAX_GRAPH, 'DYNAMIC_GRAPH_COUNT_CAP')
+            full[pid], raw, cmd = dynamic_proc(cfg, pid, budget)
+            payloads[pid] = (raw, cmd)
+        return full[pid]
+    for pid in candidates:
+        row = collect(pid)
+        need(row['exe'] == candidates[pid]['exe'] and row['cmdlineSha256'] == candidates[pid]['cmdlineSha256']
+             and {k: row[k] for k in candidates[pid]['identity']} == candidates[pid]['identity'],
+             'DYNAMIC_SCAN_TO_RECORD_DRIFT')
+        seen, current = set(), pid
+        for depth in range(DYNAMIC_MAX_DEPTH):
+            need(current not in seen, 'DYNAMIC_PARENT_CYCLE'); seen.add(current)
+            child = collect(current); parent = child['ppid']
+            if current == 1:
+                need(parent == 0, 'DYNAMIC_PID1_ROOT_PARENT'); break
+            need(parent > 0, 'DYNAMIC_UNKNOWN_PARENT_CHAIN')
+            prow = collect(parent)
+            need(prow['startTicks'] <= child['startTicks'], 'DYNAMIC_PARENT_START_ORDER')
+            current = parent
+        else:
+            raise ReleaseError('DYNAMIC_PARENT_DEPTH_CAP')
+    daemon = full[main]; daemon_raw, daemon_cmd = payloads[main]
+    daemon_env = raw_values(daemon_raw)
+    need(daemon['exe'] == str(cfg.node) and daemon_cmd.startswith(b'PM2 ')
+         and daemon_env.get(b'PM2_HOME', os.fsencode(cfg.pm2_home)) == os.fsencode(cfg.pm2_home)
+         and daemon_cmd.split(b'\0')[0].endswith(b'God Daemon (' + os.fsencode(cfg.pm2_home) + b')'),
+         'DYNAMIC_MAIN_GOD_BINDING')
+    paths = {cfg.node, script, *cfg.execution_sources}
+    for row in full.values():
+        paths.update(Path(p) for p in (row['exe'], *row['scriptPaths'], *row['mappedSourcePaths']))
+    need(len(paths) <= DYNAMIC_MAX_SOURCES, 'DYNAMIC_SOURCE_COUNT_CAP')
+    source_meta = {str(p): dynamic_source(p, budget) for p in sorted(paths)}
+    for row in full.values():
+        for path, segments in row['mappedSourceIdentity'].items():
+            sm = source_meta[path]
+            for perms, offset, device, inode in segments:
+                major, minor = (int(v, 16) for v in device.split(':'))
+                need(int(inode) == sm['ino'] and major == os.major(sm['dev'])
+                     and minor == os.minor(sm['dev']), 'DYNAMIC_MAPPING_FILE_IDENTITY')
+    own, own_pids = {}, set()
+    for pid in candidates:
+        row = full[pid]
+        # cfg.node bytes are fresh and full-META bound, not basename trust.
+        own_row = dynamic_owned(cfg, row, payloads[pid][0], main, source_meta[row['exe']], source_meta[str(cfg.node)]['sha256'])
+        if own_row is not None:
+            need(own_row['id'] not in own, 'DYNAMIC_DUPLICATE_OWN_SLOT')
+            own[own_row['id']] = own_row; own_pids.add(pid)
+    need(set(own) == set(OWN_DYNAMIC_IDS), 'DYNAMIC_ALL_SIX_OWN_REQUIRED')
+    # An owned slot may never hide a foreign parent or become an ancestor itself.
+    need(not any(r['ppid'] in own_pids for r in full.values()), 'DYNAMIC_OWN_HAS_CHILD_NO_EXEMPTION')
+    known = []
+    for pid in candidates:
+        row = full[pid]
+        if str(script) in row['scriptPaths']:
+            parent = full[row['ppid']]
+            need(Path(row['exe']).name.startswith('node') and row['exe'] == str(cfg.node)
+                 and row['cwd'] == str(cwd) and Path(parent['exe']).name == 'flock'
+                 and payloads[pid][1] == os.fsencode(cfg.node) + b'\0' + os.fsencode(script) + b'\0',
+                 'DYNAMIC_KNOWN_ACTIVE_PARENT_SCRIPT_BINDING')
+            known.append(dict(pid=pid, ppid=row['ppid'], startTicks=row['startTicks'],
+                              parentStartTicks=parent['startTicks'], script=str(script), cwd=str(cwd)))
+    # Close source/root phases with COMPLETE proc+set, then source/root rereads.
+    need({str(p): describe(p) for p in sorted({ops, cwd, *cfg.execution_roots})} == roots,
+         'DYNAMIC_ROOT_PHASE_META_DRIFT')
+    need(dynamic_scan(cfg, budget) == candidates, 'DYNAMIC_NODE_SET_END_DRIFT')
+    for pid, row in full.items():
+        need(dynamic_proc(cfg, pid, budget)[0] == row, 'DYNAMIC_FINAL_FULL_PROC_DRIFT')
+    need({str(p): dynamic_source(p, budget) for p in sorted(paths)} == source_meta,
+         'DYNAMIC_FINAL_SOURCE_META_DRIFT')
+    need({str(p): describe(p) for p in sorted({ops, cwd, *cfg.execution_roots})} == roots,
+         'DYNAMIC_FINAL_ROOT_META_DRIFT')
+    need(dynamic_source(cfg.pm2_home / 'pm2.pid', budget) == pidfile,
+         'DYNAMIC_MAIN_PIDFILE_META_DRIFT')
+    need(dynamic_scan(cfg, budget) == candidates, 'DYNAMIC_NODE_SET_FINAL_DRIFT')
+    dynamic_check(budget)
+    return dict(fixtureOnly=cfg.mock, schema='dynamic-foreignproc-r5-v1',
+                processes=[full[p] for p in sorted(full) if p not in own_pids],
+                activeForeignNodePids=sorted(set(candidates) - own_pids),
+                ownedSlotsStable=dict(requiredCount=6, slots=[own[k] for k in sorted(own)]),
+                knownRecommendationObservation=dict(state='observed-active' if known else 'observed-absent-not-retired',
+                                                     matchedActive=known, source=str(script)),
+                sources={p: r['sha256'] for p, r in source_meta.items()},
+                fullSourceMeta=source_meta, rootMeta=roots,
+                sourceGraphReviewRequired=True, semanticsClosed=False,
+                pid1Policy='recorded-full-root-with-ppid-zero')
+
+
+def dynamic_protection(cfg, fixture=None):
+    need(fixture is None or cfg.mock, 'EXTERNAL_FIXTURE_ONLY_NO_PRODUCTION_OVERRIDE')
+    if fixture is None:
+        need(cfg.proc == Path('/proc'), 'EXTERNAL_FIXED_PRODUCTION_PROC')
+        ops, cwd, script = EXTERNAL_OPS, EXTERNAL_CWD, EXTERNAL_SCRIPT
+    else:
+        exact(fixture, 'ops cwd script', 'EXTERNAL_FIXTURE_PATH_SCHEMA')
+        ops, cwd, script = (no_link(fixture[k]) for k in ('ops', 'cwd', 'script'))
+    need(ops in cfg.extra_protected and cwd in cfg.extra_protected and ops in script.parents,
+         'EXTERNAL_REQUIRED_EXACT_ROOTS')
+    budget = dynamic_budget()
+    first = dynamic_protection_sample(cfg, ops, cwd, script, budget)
+    second = dynamic_protection_sample(cfg, ops, cwd, script, budget)
+    need(first == second, 'DYNAMIC_TWO_COMPLETE_SAMPLE_DRIFT')
+    return first
+
 
 def transport(cfg):
     external = external_protection(cfg)
