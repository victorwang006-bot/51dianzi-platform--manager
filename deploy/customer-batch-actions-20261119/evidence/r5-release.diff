+def dynamic_owned(cfg, record, raw, main, node_meta, node_hash):
+    # This is exemption routing, NOT readiness or normalized environment proof.
+    if record['ppid'] != main:
+        return None
+    outer = raw_values(raw)
+    if b'pm2_env' not in outer:
+        return None
+    value, _, _ = pm2_top_tokens(outer[b'pm2_env'])
+    slot = value.get('pm_id')
+    claims_own = (integer(slot) and slot in OWN_DYNAMIC_IDS) or value.get('name') in ('dianzi51', 'dianzi51-admin')
+    if not claims_own:
+        return None
+    need(integer(slot) and slot in OWN_DYNAMIC_IDS, 'DYNAMIC_OWN_SLOT_SPOOF')
+    admin = slot in (191, 192); script = cfg.admin_api if admin else cfg.front_api
+    name = 'dianzi51-admin' if admin else 'dianzi51'
+    current_cwd = value.get('pm_cwd')
+    need(isinstance(current_cwd, str) and current_cwd.startswith('/')
+         and str(no_link(current_cwd)) == current_cwd and '..' not in Path(current_cwd).parts,
+         'DYNAMIC_OWN_SERIALIZED_CWD_CANONICAL')
+    need(value.get('name') == name and value.get('exec_mode') == 'cluster_mode'
+         and value.get('pm_exec_path') == str(script)
+         and record['cwd'] == current_cwd
+         and record['exe'] == str(cfg.node)
+         and node_meta['sha256'] == node_hash,
+         'DYNAMIC_OWN_KERNEL_AND_SERIALIZED_BINDING')
+    return dict(id=slot, name=name, script=str(script), cwd=current_cwd,
+                execMode='cluster_mode', daemonPpid=main, exe=str(cfg.node),
+                exeSha256=node_meta['sha256'],
+                executionSourcePaths=sorted({record['exe'], *record['scriptPaths'], *record['mappedSourcePaths']}),
+                mappedSourceIdentity=record['mappedSourceIdentity'])
+
