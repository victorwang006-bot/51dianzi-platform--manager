+# R5 production discovery is pure proc/source reading; legacy fixed helpers above
+# remain historical fixture-only code. No FD/log content, loaders or module runs.
+DYNAMIC_MAX_PROC = 8192
+DYNAMIC_MAX_NODES = 128
+DYNAMIC_MAX_GRAPH = 256
+DYNAMIC_MAX_DEPTH = 64
+DYNAMIC_MAX_SOURCES = 512
+DYNAMIC_PROC_BYTES = 1024 * 1024
+DYNAMIC_SOURCE_BYTES = 256 * 1024 * 1024
+DYNAMIC_TOTAL_BYTES = 2 * 1024 * 1024 * 1024
+DYNAMIC_SECONDS = 120
+OWN_DYNAMIC_IDS = (190, 191, 192, 193, 194, 200)
+
