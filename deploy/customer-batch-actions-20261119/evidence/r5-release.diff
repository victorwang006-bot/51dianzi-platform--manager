+def dynamic_budget():
+    return dict(start=time.monotonic(), bytes=0)
+
+
+def dynamic_check(budget):
+    need(time.monotonic() - budget['start'] <= DYNAMIC_SECONDS,
+         'DYNAMIC_TIME_CAP')
+    need(budget['bytes'] <= DYNAMIC_TOTAL_BYTES, 'DYNAMIC_TOTAL_BYTE_CAP')
+
+
+def dynamic_read(path, limit, budget, source=False):
+    dynamic_check(budget)
+    p = no_link(path)
+    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        before = os.fstat(fd)
+        need(stat.S_ISREG(before.st_mode), 'DYNAMIC_REGULAR_READ_REQUIRED')
+        if source:
+            need(before.st_nlink == 1 and before.st_size <= limit,
+                 'DYNAMIC_SOURCE_SINGLE_FILE_BYTE_CAP')
+        chunks, count = [], 0
+        while True:
+            dynamic_check(budget)
+            data = os.read(fd, min(65536, limit + 1 - count))
+            if not data:
+                break
+            count += len(data); budget['bytes'] += len(data)
+            need(count <= limit, 'DYNAMIC_SINGLE_FILE_BYTE_CAP')
+            dynamic_check(budget)
+            chunks.append(data)
+        after = os.fstat(fd)
+        need((before.st_dev, before.st_ino, before.st_mode, before.st_uid,
+              before.st_gid, before.st_nlink, before.st_size, before.st_mtime_ns,
+              before.st_ctime_ns) ==
+             (after.st_dev, after.st_ino, after.st_mode, after.st_uid,
+              after.st_gid, after.st_nlink, after.st_size, after.st_mtime_ns,
+              after.st_ctime_ns), 'DYNAMIC_FILE_READ_RACE')
+        need(p.lstat().st_ino == after.st_ino and p.lstat().st_dev == after.st_dev,
+             'DYNAMIC_FILE_RENAME_RACE')
+        return b''.join(chunks)
+    finally:
+        os.close(fd)
+
+
+def dynamic_source(path, budget):
+    p = no_link(path); before = meta(p)
+    need(stat.S_ISREG(before['statmode']) and before['nlink'] == 1,
+         'DYNAMIC_SINGLE_REGULAR_SOURCE')
+    data = dynamic_read(p, DYNAMIC_SOURCE_BYTES, budget, True)
+    need(meta(p) == before, 'DYNAMIC_SOURCE_META_READ_RACE')
+    return dict(before, kind='file', sha256=H(data))
+
+
+def dynamic_identity(cfg, pid, budget):
+    data = dynamic_read(cfg.proc / str(pid) / 'stat', DYNAMIC_PROC_BYTES, budget)
+    head, sep, tail = data.rpartition(b') '); fields = tail.split()
+    prefix = str(pid).encode() + b' ('
+    need(sep and head.startswith(prefix) and len(fields) >= 20
+         and fields[0] in (b'R', b'S', b'D', b'T', b't', b'I')
+         and re.fullmatch(rb'[0-9]+', fields[1])
+         and re.fullmatch(rb'[1-9][0-9]*', fields[19]), 'DYNAMIC_LIVE_STAT_IDENTITY')
+    return dict(pid=pid, ppid=int(fields[1]), startTicks=int(fields[19]),
+                nameSha256=H(head[len(prefix):]))
+
+
+def dynamic_scan(cfg, budget):
+    candidates, count = {}, 0
+    # Bound enumeration itself, not just the final candidate list.
+    for p in cfg.proc.iterdir():
+        dynamic_check(budget); count += 1
+        need(count <= DYNAMIC_MAX_PROC, 'DYNAMIC_PROC_COUNT_CAP')
+        if not re.fullmatch(r'[1-9][0-9]*', p.name):
+            continue
+        exe, cmd = None, None
+        try:
+            exe = os.readlink(p / 'exe')
+        except (FileNotFoundError, ProcessLookupError):
+            pass  # only an as-yet-unclassified transient may disappear
+        selected = exe is not None and Path(exe.removesuffix(' (deleted)')).name.startswith('node')
+        try:
+            cmd = dynamic_read(p / 'cmdline', DYNAMIC_PROC_BYTES, budget)
+        except (FileNotFoundError, ProcessLookupError):
+            need(not selected, 'DYNAMIC_CANDIDATE_DISAPPEARED')
+        selected = selected or (cmd is not None and cmd.startswith(b'PM2 '))
+        if not selected:
+            continue
+        need(exe is not None and cmd is not None, 'DYNAMIC_CANDIDATE_INCOMPLETE')
+        pid = int(p.name)
+        candidates[pid] = dict(identity=dynamic_identity(cfg, pid, budget),
+                               exe=exe, cmdlineSha256=H(cmd))
+        need(len(candidates) <= DYNAMIC_MAX_NODES, 'DYNAMIC_NODE_COUNT_CAP')
+    return dict(sorted(candidates.items()))
+
+
+def dynamic_permissions(status):
+    fields, opaque = {}, []
+    for line in status.splitlines():
+        k, _, v = line.partition(b':')
+        if k in (b'Uid', b'Gid', b'Groups', b'Umask'):
+            need(k not in fields, 'DYNAMIC_PERMISSION_DUPLICATE')
+            fields[k.decode()] = [x.decode('ascii') for x in v.split()]
+            opaque.append(line + b'\n')
+    need(set(fields) == {'Uid', 'Gid', 'Groups', 'Umask'}, 'DYNAMIC_PERMISSION_FIELDS')
+    return H(b''.join(opaque))
+
+
+def dynamic_maps(maps):
+    mapped = {}
+    for line in maps.splitlines():
+        parts = line.split(None, 5)  # final field is the WHOLE path incl spaces
+        need(len(parts) >= 5 and re.fullmatch(rb'[0-9a-f]+-[0-9a-f]+', parts[0])
+             and re.fullmatch(rb'[r-][w-][x-][ps]', parts[1])
+             and re.fullmatch(rb'[0-9a-f]+', parts[2])
+             and re.fullmatch(rb'[0-9a-f]+:[0-9a-f]+', parts[3])
+             and re.fullmatch(rb'[0-9]+', parts[4]), 'DYNAMIC_MAPS_FORMAT')
+        if len(parts) == 6:
+            path = os.fsdecode(parts[5])
+            if path.startswith('/'):
+                need(not path.endswith(' (deleted)') and '\\' not in path,
+                     'DYNAMIC_DELETED_OR_ESCAPED_MAPPING')
+                p = no_link(path)
+                need(str(p) == path and '..' not in p.parts, 'DYNAMIC_MAPPING_CANONICAL')
+                # Anonymous heaps/ASLR addresses are not execution-source identity.
+                segment = [x.decode('ascii') for x in parts[1:5]]
+                mapped.setdefault(path, [])
+                if segment not in mapped[path]:
+                    mapped[path].append(segment)
+            else:
+                need(path.startswith('[') and path.endswith(']'), 'DYNAMIC_UNSUPPORTED_MAPPING')
+    return {p: sorted(mapped[p]) for p in sorted(mapped)}
+
+
+def dynamic_proc(cfg, pid, budget):
+    identity = dynamic_identity(cfg, pid, budget)
+    proc = no_link(cfg.proc / str(pid)); proc_meta = meta(proc)
+    exe = external_proc_link(cfg, pid, 'exe'); cwd = external_proc_link(cfg, pid, 'cwd')
+    links = {n: meta(proc / n) for n in ('exe', 'cwd')}
+    cwd_meta = describe(cwd)
+    need(cwd_meta['kind'] == 'directory', 'DYNAMIC_SHALLOW_CWD_DIRECTORY')
+    cmd = dynamic_read(proc / 'cmdline', DYNAMIC_PROC_BYTES, budget)
+    raw = dynamic_read(proc / 'environ', DYNAMIC_PROC_BYTES, budget)
+    status = dynamic_read(proc / 'status', DYNAMIC_PROC_BYTES, budget)
+    maps = dynamic_read(proc / 'maps', DYNAMIC_PROC_BYTES, budget)
+    need(cmd and cmd.endswith(b'\0') and (not raw or raw.endswith(b'\0')),
+         'DYNAMIC_OPAQUE_NUL_REQUIRED')
+    permission_hash = dynamic_permissions(status)
+    scripts = set()
+    for arg in cmd[:-1].split(b'\0'):
+        if arg.startswith(b'/') and arg.endswith((b'.js', b'.mjs', b'.cjs')):
+            path = os.fsdecode(arg); p = no_link(path)
+            need(str(p) == path and '..' not in p.parts, 'DYNAMIC_SCRIPT_CANONICAL')
+            scripts.add(path)
+    mapped = dynamic_maps(maps)
+    record = dict(identity, exe=str(exe), cwd=str(cwd), procMeta=proc_meta,
+                  kernelLinkMeta=links, cwdMeta=cwd_meta, rawSha256=H(raw),
+                  cmdlineSha256=H(cmd), permissionsSha256=permission_hash,
+                  mappedSourceIdentity=mapped, scriptPaths=sorted(scripts), mappedSourcePaths=sorted(mapped))
+    need(dynamic_identity(cfg, pid, budget) == identity and meta(proc) == proc_meta
+         and external_proc_link(cfg, pid, 'exe') == exe
+         and external_proc_link(cfg, pid, 'cwd') == cwd
+         and {n: meta(proc / n) for n in ('exe', 'cwd')} == links
+         and describe(cwd) == cwd_meta
+         and dynamic_read(proc / 'cmdline', DYNAMIC_PROC_BYTES, budget) == cmd
+         and dynamic_read(proc / 'environ', DYNAMIC_PROC_BYTES, budget) == raw
+         and dynamic_permissions(dynamic_read(proc / 'status', DYNAMIC_PROC_BYTES, budget)) == permission_hash
+         and dynamic_maps(dynamic_read(proc / 'maps', DYNAMIC_PROC_BYTES, budget)) == mapped,
+         'DYNAMIC_FULL_PROC_READ_RACE')
+    return record, raw, cmd
+
