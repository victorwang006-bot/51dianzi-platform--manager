+def pm2_json_domain(value):
+    """Pure model/serialized JSON-tree guard, not original daemon typed evidence.
+    fclone assigns into {}, so any own __proto__ key is outside its proof domain.
+    Never strip, normalize, replace Unicode or infer hidden source object shape.
+    """
+    seen = set()
+    def walk(v):
+        t = type(v)
+        if v is None or t is bool:
+            return
+        if t is str:
+            v.encode('utf8', 'strict')
+        elif t is int:
+            need(-(2**53) < v < 2**53, 'PM2_JSON_DOMAIN_UNSAFE_INTEGER')
+        elif t is float:
+            need(math.isfinite(v), 'PM2_JSON_DOMAIN_NONFINITE')
+        elif t in (dict, list):
+            need(id(v) not in seen, 'PM2_JSON_DOMAIN_TREE_REQUIRED')
+            seen.add(id(v))
+            if t is dict:
+                for k, x in v.items():
+                    need(type(k) is str, 'PM2_JSON_DOMAIN_STRING_KEY')
+                    need(k != '__proto__', 'PM2_JSON_DOMAIN_PROTO_KEY')
+                    walk(k); walk(x)
+            else:
+                for x in v:
+                    walk(x)
+        else:
+            raise ReleaseError('PM2_JSON_DOMAIN_TYPE')
+    try:
+        walk(value)
+    except (UnicodeError, RecursionError) as exc:
+        raise ReleaseError('PM2_JSON_DOMAIN_UTF8_OR_DEPTH') from exc
+
